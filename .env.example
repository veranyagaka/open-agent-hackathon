# Copy this file to .env and fill in credentials locally.
# Never commit .env or share live tokens.

# Offline mode for judges: true = no Zetaris, no Nightshift, no keys; data/sample + rule-based agents
SAMPLE_MODE=false

# LLM provider: Meterless Nightshift (OpenAI-compatible runtime on this machine)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Nightshift > Settings > runtime token (Windows: %LOCALAPPDATA%\ai.meterless.runtime\proxy-token)
METERLESS_RUNTIME_TOKEN=replace_with_your_runtime_token
# Lanes; pin Nemotron routes in Nightshift. The NVIDIA key lives in Nightshift, never here.
METERLESS_MODEL_DEEP=meterless/deep
METERLESS_MODEL_FAST=meterless/fast
# Fallback for the deep lane when METERLESS_MODEL_DEEP is unset
# METERLESS_MODEL=meterless/deep
# Force the LLM on/off (default: on unless SAMPLE_MODE=true; SAMPLE_MODE=true always means off)
# STOCKWHY_USE_LLM=true
# Per-run cap on Nightshift calls (free NVIDIA endpoints are rate-limited)
STOCKWHY_MAX_LLM_CALLS=30
# One HTTP request; one agent call including retries; answer budget; base backoff for 429/5xx
# STOCKWHY_LLM_TIMEOUT_S=180
# STOCKWHY_LLM_DEADLINE_S=300
# STOCKWHY_LLM_MAX_TOKENS=4096
# STOCKWHY_LLM_BACKOFF_S=2

# Zetaris SQL Editor (data layer)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=replace_with_your_zetaris_api_key
# 1 is the organisation ID on a local install
ZETARIS_ORG_ID=1
# Datasources registered by scripts/setup_live.py (data/sample/zetaris_register.sql)
ZETARIS_SCHEMA=stockwhy_pg
ZETARIS_WEB_SCHEMA=stockwhy_web
# Seconds per Zetaris request (a 5xx or reset connection is retried once)
# ZETARIS_TIMEOUT_S=120

# Data source: csv (default) or zetaris.
# zetaris reads data/sample (the one dataset registered in Zetaris) through Zetaris;
# any other --dataset folder is still read from its CSV files.
# SAMPLE_MODE=true always uses csv, so judges can run everything offline.
STOCKWHY_DATA_SOURCE=csv

# --- Live data setup (docker-compose.yml + scripts/setup_live.py) -------------------
# Postgres reachable from both this machine and the Zetaris container.
PG_HOST=localhost
PG_PORT=5433
PG_USER=stockwhy
# Any long random string, e.g. `openssl rand -hex 16`
PG_PASSWORD=replace_with_a_long_random_string
PG_DATABASE=stockwhy
PG_WEB_DATABASE=stockwhy_web
# e.g. ?sslmode=require for a cloud Postgres
PG_JDBC_PARAMS=
# Address Zetaris uses to reach Postgres, if different from PG_HOST/PG_PORT
# (PG_ZETARIS_PORT defaults to 5432 when PG_ZETARIS_HOST is set).
# With the bundled container (`docker compose up -d`, Zetaris running in Docker on this laptop):
PG_ZETARIS_HOST=stockwhy-pg
PG_ZETARIS_PORT=5432
# then `python scripts/setup_live.py --skip-load` (the container seeds both databases itself).

# --- Optional --------------------------------------------------------------------
# Trace folder and case memory file (defaults: <repo>/logs and <repo>/logs/memory/hmem.json)
# STOCKWHY_LOGS_DIR=logs
# STOCKWHY_MEMORY_PATH=logs/memory/hmem.json
# Key that signs Scout contracts (default: a random key per process). Any long random string.
# SCOUT_SIGNING_KEY=replace_with_a_long_random_string
# Demo fault drill: corrupt one cited value on the first pass (H1..H7)
# STOCKWHY_INJECT_FAULT=H1
