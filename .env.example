# Copy this file to .env and fill in credentials locally.
# Never commit .env or share live tokens.

# LLM provider: Meterless Nightshift
METERLESS_BASE_URL=https://your-nightshift-runtime-url
METERLESS_RUNTIME_TOKEN=replace_with_your_runtime_token
METERLESS_MODEL_DEEP=meterless/deep

# Zetaris SQL Editor (data layer)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=replace_with_your_zetaris_api_key
# 1 is the organisation ID on a local install
ZETARIS_ORG_ID=1
# Datasources registered by scripts/setup_live.py (data/sample/zetaris_register.sql)
ZETARIS_SCHEMA=stockwhy_pg
ZETARIS_WEB_SCHEMA=stockwhy_web

# Data source: csv (default) or zetaris.
# zetaris reads data/sample (the one dataset registered in Zetaris) through Zetaris;
# any other --dataset folder is still read from its CSV files.
# SAMPLE_MODE=true always uses csv, so judges can run everything offline.
STOCKWHY_DATA_SOURCE=csv

# --- Live data setup (docker-compose.yml + scripts/setup_live.py) -------------------
# Postgres reachable from both this machine and the Zetaris container.
PG_HOST=localhost
PG_PORT=5433
PG_USER=stockwhy
# Any long random string, e.g. `openssl rand -hex 16`
PG_PASSWORD=replace_with_a_long_random_string
PG_DATABASE=stockwhy
PG_WEB_DATABASE=stockwhy_web
# e.g. ?sslmode=require for a cloud Postgres
PG_JDBC_PARAMS=
# Address Zetaris uses to reach Postgres, if different from PG_HOST/PG_PORT.
# With the bundled container (`docker compose up -d`, Zetaris running in Docker on this laptop):
PG_ZETARIS_HOST=stockwhy-pg
PG_ZETARIS_PORT=5432
# then `python scripts/setup_live.py --skip-load` (the container seeds both databases itself).

# Legacy/local demo setting
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
SAMPLE_MODE=false
