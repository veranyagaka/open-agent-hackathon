# Copy this file to .env and fill in credentials locally.
# SAMPLE_MODE=true runs fully offline and does not require these credentials.

# LLM provider: Meterless Nightshift (live mode only)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=replace_with_your_runtime_token
METERLESS_MODEL_DEEP=meterless/auto
# Optional: pin to a Nemotron lane available in Nightshift Providers:
# METERLESS_MODEL_DEEP=nvidia/nemotron-3.5-lightning-30b-a3b

# Zetaris SQL Editor
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=replace_with_your_zetaris_api_key
ZETARIS_ORG_ID=1
ZETARIS_SCHEMA=STOCKWHY_PG

# Local dataset path (used when --dataset is omitted)
STOCKWHY_DATASET=data/sample

# Data source: csv (default) or zetaris; sample mode always uses local CSV
STOCKWHY_DATA_SOURCE=csv
STOCKWHY_WORLD_MODEL_DB=logs/stockwhy_world_model.sqlite3

# No live services or API credentials are used in offline sample mode.
SAMPLE_MODE=false
